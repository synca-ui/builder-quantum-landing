# Maitr-Backend — Umgebungsvariablen
# Alle Secrets NUR hier / im Secrets-Manager, niemals im Repo committen.

# 32-Byte-Schlüssel als Hex (64 Zeichen) für die Token-Verschlüsselung (AES-256-GCM).
# Erzeugen: openssl rand -hex 32
MAITR_ENCRYPTION_KEY=

# Secret zum Signieren des OAuth-state (CSRF). Mind. 32 Zeichen.
# Erzeugen: openssl rand -base64 48
MAITR_OAUTH_STATE_SECRET=

# Öffentliche Basis-URL des Backends (für OAuth-Redirects), z. B. https://maitr.de/api
MAITR_API_BASE_URL=

# Deep-Link zurück in die App nach dem OAuth-Callback
MAITR_APP_DEEP_LINK=maitr://connected

# Google Cloud OAuth-Client (Business Profile API)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta-App (Instagram Graph + Facebook Pages)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Datenbank (bereits vom bestehenden Server genutzt)
# DATABASE_URL=
