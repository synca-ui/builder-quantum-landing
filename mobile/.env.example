# Nur Variablen mit dem Präfix EXPO_PUBLIC_ landen im Bundle - und sind damit für
# jeden lesbar, der die App auseinandernimmt. Geheimnisse gehören hinter die Express-API.
#
# Datei kopieren: cp .env.example .env - danach Metro neu starten (npx expo start -c),
# denn Expo schreibt diese Werte zur Bauzeit fest ins Bundle.

# --- API ---------------------------------------------------------------------
# Basis-URL der Maitr-API. Der Pfad endet auf /api/maitr - dort hängt der
# Maitr-Router (server/maitr/index.ts), und genau diesen Wert setzt eas.json für
# den Produktionsbau.
#
# Welche Adresse gehört vor den Pfad?
#   iOS-Simulator      http://localhost:8081     (teilt den Netz-Stack mit dem Mac)
#   Android-Emulator   http://10.0.2.2:8081      (localhost wäre der Emulator selbst)
#   Echtes Gerät       http://<LAN-IP-des-Macs>:8081, z. B. http://192.168.1.42:8081
#   Produktion         https://maitr.de
#
# Port 8081, weil Express im Entwicklungsbetrieb im Vite-Server mitläuft
# (vite.config.ts). Der eigenständige Produktionsstart nutzt PORT bzw. 3000.
EXPO_PUBLIC_API_URL=http://localhost:8081/api/maitr

# --- Anmeldung ---------------------------------------------------------------
# Clerk Publishable Key aus dem Clerk-Dashboard (Beginnt mit pk_test_ oder pk_live_).
#
# LEER LASSEN = Demomodus: Die App startet und ist vollständig bedienbar, jeder
# Anmeldeweg meldet den Demobetrieb an, es fließt kein Token. Das ist der gewollte
# Rückfall, kein Fehler.
#
# GESETZT = echte Anmeldung: "Weiter mit Google" öffnet den Clerk-OAuth-Flow, das
# Session-Token geht als Bearer an die API (server/middleware/auth.ts prüft es).
# Voraussetzung im Clerk-Dashboard: Google als Social Connection aktiv und das
# App-Schema maitr:// als Redirect erlaubt.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- Supabase (optional) -----------------------------------------------------
# Ohne diese Werte bleibt getSupabase() deaktiviert und die App spricht
# ausschließlich mit der Express-API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
