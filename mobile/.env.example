# Nur Variablen mit dem Präfix EXPO_PUBLIC_ landen im Bundle - und sind damit für
# jeden lesbar, der die App auseinandernimmt. Geheimnisse gehören hinter die Express-API.

# Basis-URL der Express-API.
# Achtung im lokalen Betrieb: Auf dem iOS-Simulator zeigt localhost auf den Simulator,
# auf einem echten Gerät ins Nichts. Dort die LAN-IP des Macs eintragen,
# z. B. http://192.168.1.42:8080/api
EXPO_PUBLIC_API_URL=http://localhost:8080/api

# Supabase (optional). Ohne diese Werte bleibt getSupabase() deaktiviert und die App
# spricht ausschließlich mit der Express-API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Clerk (optional, sobald die mobile Anmeldung an Clerk hängt).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
