# .env.example
# Copy this file to .env and fill in your actual values
# This is a template for required environment variables

# ============================================
# CRITICAL: Authentication & Security
# ============================================

# Hinweis: JWT_SECRET gibt es nicht mehr. Es wurde nie zum Signieren benutzt
# (jsonwebtoken war nicht einmal als Laufzeit-Abhängigkeit installiert) — die
# Authentifizierung läuft vollständig über Clerk, siehe CLERK_SECRET_KEY.

# ============================================
# CRITICAL: Database
# ============================================

# PostgreSQL connection string (Neon) — die EINZIGE DB-Variable.
# Früher gab es zusätzlich NETLIFY_DATABASE_URL und DEV_DATABASE_URL; die
# Vorrangregel (Netlify vor DATABASE_URL) speiste nur eine tote Legacy-Route
# und war eine Falle beim Rotieren der Zugangsdaten.
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/maitr

# ============================================
# CRITICAL: n8n Integration
# ============================================

# Webhook URL for n8n workflow (restaurant analysis)
# This is used to forward restaurant/website links for AI analysis
# Contact DevOps for the production webhook URL
N8N_WEBHOOK_URL=https://n8n-production-xxxx.up.railway.app/webhook/your-webhook-id

# ============================================
# Optional: External Services
# ============================================

# Stripe API keys (for payment processing)
# Get these from Stripe Dashboard
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Google Analytics ID (for website analytics)
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXX

# Node environment (development, production, test)
NODE_ENV=development

# Server port (default: 3000)
PORT=3000

# ============================================
# Optional: Content Management
# ============================================

# Supabase configuration (if using Supabase Auth)
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxx

# Serverseitig für Bild-Uploads (server/services/supabaseStorage.ts).
# SUPABASE_SERVICE_ROLE_KEY umgeht Row-Level-Security — gehört AUSSCHLIESSLICH
# in die Server-Umgebung (Railway), niemals ins Repo oder in eine VITE_-Variable
# (VITE_* landet im Browser-Bundle). Fehlt die Konfiguration, antwortet
# /api/media/upload mit 503.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Stack Auth wurde entfernt: VITE_STACK_PROJECT_ID,
# VITE_STACK_PUBLISHABLE_CLIENT_KEY und STACK_SECRET_SERVER_KEY kommen im Code
# nirgends mehr vor. Authentifizierung läuft über Clerk.

# ============================================
# Netlify Publish Integration
# ============================================

# Personal Access Token – Netlify Dashboard → User settings → OAuth → New token
# Scopes required: sites:read, sites:write
NETLIFY_PAT=nfp_xxxxxxxxxxxxxxxxxxxxxxxxx

# Site ID of the main maitr.de Netlify site
# Found in: Site settings → General → Site details → Site ID
NETLIFY_SITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Build Hook URL – triggers a new deploy
# Create in: Site settings → Build & deploy → Continuous deployment → Build hooks
NETLIFY_BUILD_HOOK_URL=https://api.netlify.com/build_hooks/xxxxxxxxxxxxxxxxxxxxxxxx

# Public base domain for published sites (default: maitr.de)
PUBLIC_BASE_DOMAIN=maitr.de

