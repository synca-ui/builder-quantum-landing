          "jsCode": "// 1. DATEN-ZUGRIFF (Korrektur: Greift direkt auf Webhook zu für SSL-Check)\nconst url = $(\"Webhook1\").item.json.body?.link || $(\"Webhook1\").item.json.link || \"\"; \nconst content = $input.item.json.data || \"\"; \n\n// 2. PATTERNS & PROVIDER (State-of-the-Art 2026)\nconst resProviders = /opentable|resmio|quandoo|sevenrooms|book-a-table|thefork|discoeat|formitable|superbexperience|shore\\.com|eatsms|tablecheck|covermanager|booku|reservation|booking|appointment|termin/i;\nconst resKeywords = /(?:tisch|online|jetzt|hier)\\s*(?:reservieren|buchen|reservierung|anfrage)/i;\n\n// 3. EXTRAKTION\nconst email = (content.match(/[\\w.-]+@[\\w.-]+\\.[a-z]{2,}/i) || [])[0] || null;\nconst phone = (content.match(/(?:\\+49|0049|0)(?:\\s?\\d){7,12}/) || [])[0] || null;\nconst instagram = (content.match(/https?:\\/\\/(www\\.)?instagram\\.com\\/[^\\s)\\]]+/i) || [])[0] || null;\n\n// Menü-Erkennung (Priorisiert PDF vor Markdown-Links)\nconst menuUrl = (content.match(/https?:\\/\\/[^\\s)\\]]+\\.pdf/i) || [])[0] || content.match(/\\[.*?(?:Karte|Menu|Speisen|Getränke).*?\\]\\((.*?)\\)/i)?.[1] || null;\n\n// 4. INTELLIGENTE LOGIK-CHECKS\nconst isSsl = url.toLowerCase().startsWith(\"https\"); // SSL-Fix\nconst hasRes = resProviders.test(content) || (resKeywords.test(content) && content.includes('http'));\nconst hasHours = /(?:Mo|Di|Mi|Do|Fr|Sa|So|Öffnungszeiten).*?\\d{1,2}[:.]\\d{2}/i.test(content);\nconst businessName = (content.match(/^#\\s+(.*)/m)?.[1] || \"Restaurant\").trim().substring(0, 100);\n\n// 5. MAITR-SCORE BERECHNUNG (Gewichtet)\nlet score = 0;\nif (isSsl) score += 10;\nif (email && /impressum/i.test(content)) score += 20; // Vertrauen\nif (menuUrl) score += 30;                            // UX (Speisekarte)\nif (hasHours) score += 15;                           // Information\nif (instagram) score += 15;                          // Social\nif (hasRes) score += 10;                             // Conversion\n\nconst maitrScore = Math.min(score, 100);\n\n// 6. OUTPUT FÜR NEONDB (Flaches Format für Spalten-Mapping)\nreturn {\n    businessName,\n    businessType: /pizz/i.test(content) ? \"pizzeria\" : /café|kaffee/i.test(content) ? \"cafe\" : \"restaurant\",\n    maitrScore,\n    email,\n    phone,\n    instagramUrl: instagram,\n    menuUrl,\n    hasReservation: hasRes,\n    googleSearchQuery: `${businessName} ${phone || \"\"} Gastro`, // Vorbereitung Maps-Scrape\n    analysisFeedback: maitrScore > 80 ? \"Exzellent!\" : \"Potenzial vorhanden.\",\n    status: \"completed\",\n    isDeepScrapeReady: true,\n    extractedData: {\n        analysis_timestamp: new Date().toISOString(),\n        ssl_detected: isSsl,\n        raw_snippet: content.substring(0, 200)\n    }\n};"
        },
